{
  "schema": 1,
  "paths": {
    "rpc": "/v1",
    "session": "/v1/session"
  },
  "methods": [
    "state",
    "tabs.list",
    "tabs.create",
    "tabs.activate",
    "tabs.close",
    "navigate",
    "navigation.action",
    "snapshot",
    "text.read",
    "interact",
    "screenshot",
    "console.read",
    "console.clear",
    "lease.release"
  ],
  "nonMutatingMethods": ["state", "tabs.list", "console.read"],
  "publicTabKeys": ["id", "title", "url", "loading", "canGoBack", "canGoForward", "crashed", "agentControl"],
  "publicStateKeys": ["activeTabId", "maxTabs", "tabs"],
  "snapshotKeys": ["nodes", "snapshotId", "tabId", "text", "title", "url"],
  "snapshotNodeKeyOrder": ["ref", "role", "name"],
  "readTextKeys": [
    "tabId",
    "snapshotId",
    "ref",
    "mode",
    "offset",
    "limit",
    "text",
    "totalLength",
    "returnedLength",
    "hasMore"
  ],
  "screenshotKeys": ["tabId", "url", "title", "mediaType", "data", "width", "height"],
  "consoleEntryKeys": ["level", "message", "sourceId", "line", "timestamp"],
  "screenshotMediaType": "image/png",
  "maxTabs": 8,
  "leaseTtlMs": 60000,
  "maxConcurrency": 4,
  "maxRequestBodyBytes": 1048576,
  "errors": {
    "notFound": "Not found",
    "originRejected": "Browser origins are not accepted",
    "unauthorized": "Unauthorized",
    "leaseConflictPrefix": "Browser tab is controlled by another MCP client; user takeover is required before ",
    "leaseOwnership": "Browser tab lease belongs to another MCP client",
    "takeoverCancelled": "Browser operation was cancelled by user takeover",
    "bodyTooLarge": "Request body exceeds 1 MB",
    "bodyNotObject": "Request body must be an object",
    "clientPid": "client_pid must be a positive integer",
    "unknownMethodPrefix": "Unknown Browser Broker method: ",
    "staleSnapshot": "Browser snapshot is stale; take a new snapshot before interacting"
  },
  "statusCodes": {
    "ok": 200,
    "businessError": 400,
    "unauthorized": 401,
    "originRejected": 403,
    "notFound": 404,
    "leaseOrCancelled": 409
  },
  "descriptor": {
    "dirName": "desktop-browser",
    "fileName": "broker.json",
    "schema": 1,
    "endpointPrefix": "http://127.0.0.1:",
    "requiredKeys": ["schema", "endpoint", "token", "desktopPid", "instanceId"],
    "dirMode": "0700",
    "fileMode": "0600"
  }
}
